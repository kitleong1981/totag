# Copy this file to .env and fill in your own values.
# (This app reads plain environment variables — use `export $(cat .env | xargs)`
# or a tool like direnv/python-dotenv to load it before running app.py.)

# Folders to scan for images/videos, separated by ':' (macOS/Linux).
TOTAG_FOLDER_ROOTS=/Users/you/Pictures/Stock:/Users/you/Movies/Clips

# OpenAI-compatible vision endpoint for AI metadata generation.
# Defaults to https://api.openai.com if unset — point this elsewhere to use
# a local/self-hosted OpenAI-compatible server instead.
TOTAG_LLM_BASE_URL=https://api.openai.com

# API key sent as "Authorization: Bearer <key>" to the LLM endpoint above.
OMLX_API_KEY=sk-your-api-key-here

# Optional: reverse-geocoding + nearby-landmark keywords (Google Maps
# Geocoding + Places API). Can also be set/changed later from the app itself
# (gear icon next to the model dropdown → Google Maps API Key), which is
# usually more convenient than editing this file and restarting. Leave
# unset entirely to skip Google's part — OSM-based park/landmark containment
# keywords (Overpass API) work with no key at all either way.
GOOGLE_MAPS_API_KEY=

# Optional: path to your stock-site FTP/SFTP credentials file. Defaults to
# ./microstock_config.json (gitignored — never commit real credentials).
TOTAG_MICROSTOCK_CONFIG_PATH=

# Optional: what address the server binds to. Defaults to 127.0.0.1
# (localhost only) — several routes serve/delete/move files by path and
# there's no authentication in front of this app, so only change this if
# you specifically want LAN/remote access (e.g. your Tailscale IP) and
# understand the exposure.
TOTAG_HOST=

# Optional: set to 1/true to enable Flask's debug mode (auto-reload +
# interactive in-browser debugger/code-execution on unhandled errors).
# Leave unset in normal use — the interactive debugger is a code-execution
# risk if this is ever reachable from anywhere but your own machine.
TOTAG_DEBUG=

# Optional: port to listen on. Defaults to 5001.
TOTAG_PORT=
